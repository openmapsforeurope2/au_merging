{
    "version": "0.2.0",
    "configurations": [
        {
        "name": "(gdb) Pipe Launch",
        "type": "cppdbg",
        "request": "launch",
        "program": "/usr/local/src/au_merging/bin/au_mergingd",
        "cwd": "/usr/local/src/au_merging",
        "args": ["--c", "/usr/local/src/au_merging/config/epg_parameters.ini", "--l", "5", "--s", "test", "fr"],
        "stopAtEntry": true,
        "environment": [{ "name": "config", "value": "Debug" }],
        "externalConsole": true,
        "sourceFileMap": {
            "/usr/local/src/au_merging/src":"${workspaceRoot}/src",
            "/usr/local/src/libepg/src":"${workspaceRoot}/../libepg/src",
            "/usr/local/src/socle/src":"${workspaceRoot}/../socle/src",
            "/usr/local/src/au_merging/include":"${workspaceRoot}/include",
            "/usr/local/src/libepg/include":"${workspaceRoot}/../libepg/include",
            "/usr/local/src/socle/include":"${workspaceRoot}/../socle/include"
        },
        "pipeTransport": {
            "debuggerPath": "/usr/bin/gdb",
            "pipeProgram": "docker",
            "pipeArgs": ["exec", "-i", "au_merging_dev_container", "sh", "-c"],
            "pipeCwd": "${workspaceRoot}"
        },
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }
        ]
    }, ]
}